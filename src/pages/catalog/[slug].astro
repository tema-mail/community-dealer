---
import Base from '../../layouts/Base.astro';
import CarCard from '../../components/CarCard.astro';
import Gallery from '../../components/Gallery';
import { cars, carName, formatPrice, type Car } from '../../data/cars';
import { img, site, url } from '../../data/site';

export function getStaticPaths() {
  return cars.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}

const { car } = Astro.props as { car: Car };
const name = carName(car);
const photos = Array.from({ length: car.photos }, (_, n) => {
  const f = `cars/${car.slug}/${String(n + 1).padStart(2, '0')}`;
  return { small: img(`${f}-800.webp`), large: img(`${f}-1600.webp`) };
});
const specs: [string, string][] = [
  ['Год выпуска', String(car.year)],
  ['Состояние', 'Новый, пробег до 30 км'],
  ['Двигатель', car.engine],
  ['Мощность', `${car.power} л.с.`],
  ['Топливо', car.fuel],
  ['Коробка', car.gearbox],
  ['Привод', car.drive],
  ['Кузов', car.body],
  ['Руль', car.wheel],
  ['Комплектация', car.trim],
  ['Цвет кузова', car.colorName],
  ['Салон', car.interior],
  ['Транспортный налог', `${formatPrice(car.tax)} в год`],
];
const others = cars.filter((c) => c.slug !== car.slug);
const message = encodeURIComponent(`Здравствуйте! Интересует ${name} ${car.year} за ${formatPrice(car.price)}.`);
---
<Base
  title={`${name} ${car.year} – купить в Москве, ${formatPrice(car.price)} | Community Dealer`}
  description={`${name} ${car.year}, ${car.power} л.с., ${car.colorName}. В наличии в Москве, цена ${formatPrice(car.price)}. Сделка с НДС, лизинг, трейд-ин.`}
  page="car"
  solidHeader
>
  <div class="wrap pdp">
    <nav class="pdp__crumbs" aria-label="Навигация">
      <a href={url()}>Главная</a><span>/</span><a href={url('catalog/')}>Каталог</a><span>/</span><span>{name}</span>
    </nav>

    <div class="pdp__top">
      <Gallery client:load photos={photos} alt={`${name} ${car.year}, ${car.color.toLowerCase()}`} />

      <aside class="pdp__panel">
        <p class="caps pdp__status">{car.status} · Москва</p>
        <h1 class="pdp__title">{name}</h1>
        <p class="pdp__tagline muted">{car.tagline}</p>

        <dl class="pdp__keys">
          <div><dt>Год</dt><dd>{car.year}</dd></div>
          <div><dt>Мощность</dt><dd>{car.power} л.с.</dd></div>
          <div><dt>Привод</dt><dd>{car.drive}</dd></div>
        </dl>

        <p class="pdp__price">{formatPrice(car.price)}</p>
        <p class="pdp__vat muted">Цена за наличный расчёт. Возможна покупка с НДС (+22%), в лизинг или с зачётом вашего авто в трейд-ин.</p>

        <div class="pdp__cta">
          <a class="btn btn--solid" href={site.phoneHref}>Записаться на просмотр</a>
          <a class="btn" href={`${site.whatsapp}?text=${message}`} target="_blank" rel="noopener">Написать в WhatsApp</a>
        </div>

        <ul class="pdp__perks">
          <li>Полный комплект документов, юридическая чистота</li>
          <li>Аккредитованы в ключевых банках и лизинговых компаниях</li>
          <li>Оклейка, КАСКО, номера и постановка на учёт</li>
        </ul>
      </aside>
    </div>

    <section class="pdp__section">
      <h2 class="pdp__h2">Характеристики</h2>
      <dl class="pdp__specs">
        {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="pdp__section">
      <h2 class="pdp__h2">Опции</h2>
      <div class="pdp__options">
        {car.options.map((g) => (
          <div class="pdp__opt">
            <h3 class="caps">{g.title}</h3>
            <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="pdp__source muted">
        Характеристики и опции – из <a href={car.source} target="_blank" rel="noopener">объявления на auto.ru</a>. Точную спецификацию по VIN пришлём по запросу.
      </p>
    </section>

    <section class="pdp__section">
      <div class="section__head">
        <h2 class="pdp__h2">Ещё в наличии</h2>
        <a class="link-arrow caps" href={url('catalog/')}>Весь каталог</a>
      </div>
      <div class="product-grid pdp__others">
        {others.map((c) => <CarCard car={c} />)}
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .pdp { padding-top: 124px; padding-bottom: 110px; }
  .pdp__crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; color: var(--dim); margin-bottom: 24px; }
  .pdp__crumbs a { color: var(--muted); }
  .pdp__crumbs a:hover { color: var(--text); }
  .pdp__top { display: grid; grid-template-columns: 1fr; gap: 32px; }

  .gallery { min-width: 0; }
  .gallery__main { position: relative; aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; background: var(--card); }
  .gallery__main img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s var(--ease); }
  .gallery__main img.is-active { opacity: 1; }
  .gallery__arrow {
    position: absolute; top: 50%; z-index: 2; width: 44px; height: 44px; margin-top: -22px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(11, 12, 12, 0.4); border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.3s, background 0.3s;
  }
  .gallery__arrow svg { width: 18px; height: 18px; }
  .gallery__arrow--prev { left: 16px; }
  .gallery__arrow--next { right: 16px; }
  .gallery__main:hover .gallery__arrow, .gallery__arrow:focus-visible { opacity: 1; }
  @media (hover: none) { .gallery__arrow { opacity: 1; } }
  .gallery__arrow:hover { background: rgba(11, 12, 12, 0.7); }
  .gallery__count { position: absolute; right: 16px; bottom: 14px; z-index: 2; padding: 6px 10px; border-radius: 999px; background: rgba(11, 12, 12, 0.5); }
  .gallery__strip { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
  .gallery__strip::-webkit-scrollbar { display: none; }
  .gallery__thumb { flex: none; width: 96px; aspect-ratio: 3 / 2; border-radius: 4px; overflow: hidden; opacity: 0.45; outline: 1px solid transparent; transition: opacity 0.3s, outline-color 0.3s; }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb.is-active { opacity: 1; outline-color: var(--accent); }
  .gallery__thumb:hover { opacity: 0.85; }

  .pdp__status { color: var(--accent); }
  .pdp__title { margin-top: 14px; font-size: clamp(28px, 3vw, 40px); line-height: 1.1; }
  .pdp__tagline { margin-top: 12px; font-size: 14px; }
  .pdp__keys { display: grid; grid-template-columns: repeat(3, 1fr); margin: 28px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pdp__keys div { padding: 16px 0; }
  .pdp__keys div + div { padding-left: 16px; border-left: 1px solid var(--line); }
  .pdp__keys dt { font-size: 11px; color: var(--muted); }
  .pdp__keys dd { margin: 4px 0 0; font-size: 15px; }
  .pdp__price { margin-top: 28px; font: 300 clamp(26px, 2.6vw, 34px)/1 var(--f-display); }
  .pdp__vat { margin-top: 12px; font-size: 13px; }
  .pdp__cta { display: grid; gap: 10px; margin-top: 28px; }
  .pdp__perks { list-style: none; margin: 28px 0 0; padding: 0; font-size: 13px; color: #b9c2be; }
  .pdp__perks li { position: relative; padding: 0 0 10px 22px; }
  .pdp__perks li::before { content: ''; position: absolute; left: 0; top: 8px; width: 10px; height: 1px; background: var(--accent); }

  .pdp__section { margin-top: clamp(64px, 8vw, 110px); }
  .pdp__h2 { font-size: clamp(22px, 2.4vw, 32px); margin-bottom: 28px; }
  .pdp__section .section__head .pdp__h2 { margin-bottom: 0; }
  .pdp__specs { display: grid; grid-template-columns: 1fr; margin: 0; border-top: 1px solid var(--line); }
  .pdp__specs div { display: grid; grid-template-columns: 42% 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .pdp__specs dt { color: var(--muted); }
  .pdp__specs dd { margin: 0; }
  .pdp__options { display: grid; grid-template-columns: 1fr; gap: 36px; }
  .pdp__opt h3 { color: var(--accent); font-family: var(--f-body); margin-bottom: 14px; }
  .pdp__opt ul { list-style: none; margin: 0; padding: 0; }
  .pdp__opt li { padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 14px; color: #c9cdcb; }
  .pdp__source { margin-top: 28px; font-size: 12px; }
  .pdp__source a { text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 760px) {
    .pdp__specs { grid-template-columns: 1fr 1fr; column-gap: 48px; }
    .pdp__options { grid-template-columns: 1fr 1fr; column-gap: 48px; }
    .pdp__cta { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .pdp__top { grid-template-columns: minmax(0, 1.75fr) minmax(320px, 1fr); gap: 48px; align-items: start; }
    .pdp__panel { position: sticky; top: 130px; }
    .pdp__cta { grid-template-columns: 1fr; }
    .pdp__options { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  }
  @media (max-width: 600px) {
    .pdp { padding-top: 84px; }
    .gallery__main { margin: 0 calc(-1 * var(--gutter)); border-radius: 0; }
    .gallery__arrow { display: none; }
    .gallery__thumb { width: 72px; }
    .pdp__others { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
