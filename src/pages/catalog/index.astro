---
import Base from '../../layouts/Base.astro';
import CatalogView from '../../components/CatalogView.astro';
import { cars, carsWord } from '../../data/cars';

const fresh = cars.filter((c) => !c.used && c.status === 'В наличии').length;
---
<Base
  title="Каталог автомобилей в наличии – Community Dealer, Москва"
  description={`${cars.length} ${carsWord(cars.length)}: ${fresh} новых в наличии в Москве, под заказ и с пробегом – Mercedes-Benz, Range Rover, Porsche, Ferrari, Lexus, Volvo. Сделки с НДС, лизинг, трейд-ин.`}
  page="catalog"
  solidHeader
>
  <CatalogView title="Все автомобили" lead="Новые машины в наличии в Москве и любая комплектация под заказ по конфигуратору" cars={cars} active="" facet="none" />
</Base>
