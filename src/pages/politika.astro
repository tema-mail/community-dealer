---
// Юридическая страница. Реквизиты оператора (юрлицо, ИНН, ОГРН) владелец пришлёт – до запуска на боевом домене дописать.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const sections: [string, string[]][] = [
  ['1. Общие положения', [
    `Политика описывает, как ${site.full} (далее – Оператор) обрабатывает персональные данные посетителей сайта в соответствии с Федеральным законом № 152-ФЗ «О персональных данных».`,
    'Отправляя заявку на сайте, посетитель даёт согласие на обработку своих персональных данных на условиях этой политики.',
  ]],
  ['2. Какие данные обрабатываются', [
    'Имя, номер телефона, выбранный способ связи, удобное время визита и автомобиль, которым интересуется посетитель.',
    'Технические данные: адрес страницы, с которой отправлена заявка.',
  ]],
  ['3. Цели обработки', [
    'Связаться с посетителем по его заявке, записать на просмотр автомобиля, подготовить расчёт сделки.',
  ]],
  ['4. Правовое основание и сроки', [
    'Основание – согласие субъекта персональных данных. Данные хранятся до достижения цели обработки или до отзыва согласия.',
  ]],
  ['5. Передача данных', [
    'Оператор не продаёт и не передаёт персональные данные третьим лицам, кроме случаев, предусмотренных законодательством РФ. Для связи могут использоваться мессенджеры, выбранные посетителем.',
  ]],
  ['6. Права посетителя', [
    'Посетитель вправе получить сведения об обработке своих данных, потребовать их уточнения или удаления и отозвать согласие, обратившись к Оператору по контактам ниже.',
  ]],
  ['7. Контакты Оператора', [
    `${site.full}, ${site.address}. Телефон: ${site.phone}.`,
  ]],
];
---
<Base title="Политика обработки персональных данных – Community Dealer" description="Как Community Dealer обрабатывает персональные данные посетителей сайта." solidHeader>
  <article class="wrap legal">
    <h1>Политика обработки персональных данных</h1>
    <p class="muted legal__date">Редакция от 13.10.2026</p>
    {sections.map(([h, ps]) => (
      <section>
        <h2>{h}</h2>
        {ps.map((p) => <p>{p}</p>)}
      </section>
    ))}
  </article>
</Base>

<style>
  .legal { max-width: 820px; padding-top: 150px; padding-bottom: 110px; }
  .legal h1 { font-size: clamp(26px, 3.4vw, 40px); line-height: 1.15; }
  .legal__date { margin-top: 12px; font-size: 13px; }
  .legal h2 { margin-top: 44px; font-size: 18px; font-weight: 400; }
  .legal p { margin-top: 12px; color: #c3c9c6; font-size: 15px; }
</style>
