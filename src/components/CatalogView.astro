---
// Общий вид каталога (по мотивам bork.ru): слева каталоги по кузову и маркам, сверху фильтр и сортировка,
// в конце сетки – приглашение в Telegram, где весь склад.
import CarCard from './CarCard.astro';
import { type Car, bodyCatalogs, brandCatalogs, cars as allCars, carsWord, photo } from '../data/cars';
import { site, url } from '../data/site';

interface Props {
  title: string;
  lead: string;
  cars: Car[];
  /** slug текущего каталога для подсветки в меню ('' – общий) */
  active: string;
  /** по какому признаку дать фильтр: в каталоге марки – модели, в каталоге кузова – марки */
  facet: 'brand' | 'model' | 'none';
}
const { title, lead, cars, active, facet } = Astro.props;
const facetValues = facet === 'none' ? [] : [...new Set(cars.map((c) => (facet === 'brand' ? c.brand : c.model)))];
const statuses = [...new Set(cars.map((c) => (c.used ? 'С пробегом' : c.status)))];
const cover = cars[0];
---
<section class="cat-hero">
  <div class="wrap">
    <nav class="cat-hero__crumbs" aria-label="Навигация">
      <a href={url()}>Главная</a><span>/</span>
      {active ? <><a href={url('catalog/')}>Каталог</a><span>/</span><span>{title}</span></> : <span>Каталог</span>}
    </nav>
    <h1 class="cat-hero__title">{title}</h1>
    <p class="cat-hero__sub muted">{lead}</p>
    <p class="cat-hero__count caps">{cars.length} {carsWord(cars.length)}</p>
  </div>
</section>

<div class="wrap cat">
  <aside class="cat__side" aria-label="Каталоги">
    <div class="cat__group cat__group--all">
      <p class="cat__group-title">Каталог</p>
      <div class="cat__links">
        <a class:list={['cat__link', { 'is-on': active === '' }]} href={url('catalog/')}>Все автомобили <i>{allCars.length}</i></a>
      </div>
    </div>
    <div class="cat__group">
      <p class="cat__group-title">Кузов</p>
      <div class="cat__links">
        <a class:list={['cat__link cat__link--mobile', { 'is-on': active === '' }]} href={url('catalog/')}>Все <i>{allCars.length}</i></a>
        {bodyCatalogs.map((c) => (
          <a class:list={['cat__link', { 'is-on': active === c.slug }]} href={url(`catalog/${c.slug}/`)}>{c.title} <i>{c.cars.length}</i></a>
        ))}
      </div>
    </div>
    <div class="cat__group">
      <p class="cat__group-title">Марка</p>
      <div class="cat__links">
        {brandCatalogs.map((c) => (
          <a class:list={['cat__link', { 'is-on': active === c.slug }]} href={url(`catalog/${c.slug}/`)}>{c.title} <i>{c.cars.length}</i></a>
        ))}
      </div>
    </div>
  </aside>

  <div class="cat__main">
    <div class="cat__tools">
      {facetValues.length > 1 && (
        <div class="cat__filter" data-filter={facet}>
          <button type="button" class="cat__chip is-on" data-value="" aria-pressed="true">Все</button>
          {facetValues.map((v) => <button type="button" class="cat__chip" data-value={v} aria-pressed="false">{v}</button>)}
        </div>
      )}
      {statuses.length > 1 && (
        <div class="cat__filter" data-filter="status">
          <button type="button" class="cat__chip is-on" data-value="" aria-pressed="true">Все</button>
          {statuses.map((v) => <button type="button" class="cat__chip" data-value={v} aria-pressed="false">{v}</button>)}
        </div>
      )}
      <div class="cat__bar">
        <p class="cat__count muted" aria-live="polite" data-count>{cars.length} {carsWord(cars.length)}</p>
        <label class="cat__sort">
          <span class="muted">Сортировка</span>
          <select data-sort>
            <option value="price-desc">Сначала дороже</option>
            <option value="price-asc">Сначала дешевле</option>
            <option value="year-desc">Сначала новее</option>
          </select>
        </label>
      </div>
    </div>

    <div class="product-grid" data-grid>
      {cars.map((car, i) => <CarCard car={car} eager={i < 3} />)}
      <a class="card card--cta" href={site.telegram} target="_blank" rel="noopener" data-cta>
        <div class="card__media">
          {cover && <img class="card--cta__bg" src={photo(cover, 2, 800)} alt="" loading="lazy" />}
          <div>
            <h3>Не нашли свою машину?</h3>
            <p>Весь склад, машины в пути и закрытые предложения – в нашем Telegram. Новинки там появляются первыми.</p>
          </div>
          <span class="caps">Открыть Telegram</span>
        </div>
      </a>
    </div>
    <p class="cat__empty muted" hidden data-empty>По этим условиям машин сейчас нет – соберём под заказ.</p>
  </div>
</div>

<script>
  import { carsWord } from '../data/format';

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const cta = grid?.querySelector<HTMLElement>('[data-cta]');
  const cards = [...(grid?.querySelectorAll<HTMLElement>('.card:not([data-cta])') ?? [])];
  const count = document.querySelector('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const state: Record<string, string> = {};

  const apply = () => {
    let shown = 0;
    cards.forEach((card) => {
      const ok = Object.entries(state).every(([k, v]) => !v || card.dataset[k] === v);
      card.hidden = !ok;
      if (ok) shown++;
    });
    if (count) count.textContent = `${shown} ${carsWord(shown)}`;
    if (empty) empty.hidden = shown > 0;
  };

  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((group) => {
    const key = group.dataset.filter!;
    group.querySelectorAll<HTMLButtonElement>('.cat__chip').forEach((chip) =>
      chip.addEventListener('click', () => {
        state[key] = chip.dataset.value ?? '';
        group.querySelectorAll('.cat__chip').forEach((c) => {
          c.classList.toggle('is-on', c === chip);
          c.setAttribute('aria-pressed', String(c === chip));
        });
        apply();
      }),
    );
  });

  document.querySelector<HTMLSelectElement>('[data-sort]')?.addEventListener('change', (e) => {
    const [key, dir] = (e.target as HTMLSelectElement).value.split('-');
    const sorted = [...cards].sort((a, b) => (Number(a.dataset[key]) - Number(b.dataset[key])) * (dir === 'asc' ? 1 : -1));
    sorted.forEach((c) => grid?.insertBefore(c, cta ?? null));
  });
</script>

<style is:global>
  .cat-hero { padding: 140px 0 44px; text-align: center; background: radial-gradient(60% 120% at 50% 0%, var(--green) 0%, transparent 70%); }
  .cat-hero__crumbs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; font-size: 12px; color: var(--dim); margin-bottom: 28px; }
  .cat-hero__crumbs a { color: var(--muted); }
  .cat-hero__crumbs a:hover { color: var(--text); }
  .cat-hero__title { font-size: clamp(30px, 4vw, 52px); }
  .cat-hero__sub { max-width: 32em; margin: 16px auto 0; font-size: 14px; }
  .cat-hero__count { margin-top: 18px; color: var(--accent); }

  .cat { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding-bottom: 120px; }
  .cat__side, .cat__main { min-width: 0; } /* ряды чипов с прокруткой не должны раздвигать колонку */
  .cat__group { padding-bottom: 14px; }
  .cat__group-title { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
  .cat__links, .cat__filter {
    display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
    margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter);
  }
  .cat__links::-webkit-scrollbar, .cat__filter::-webkit-scrollbar { display: none; }
  .cat__link, .cat__chip {
    flex: none; display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 16px;
    border-radius: 999px; border: 1px solid var(--line-2); font-size: 13px; color: #c9cdcb; white-space: nowrap;
    transition: all 0.25s var(--ease);
  }
  .cat__link i { font-style: normal; font-size: 11px; color: var(--dim); }
  .cat__link:hover, .cat__chip:hover { border-color: var(--text); color: var(--text); }
  .cat__link.is-on, .cat__chip.is-on { background: var(--green-2); border-color: var(--green-2); color: #fff; }
  .cat__link.is-on i { color: #b9d8c9; }

  .cat__tools { display: grid; gap: 10px; margin-bottom: 28px; }
  .cat__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .cat__count { font-size: 12px; }
  .cat__sort { display: flex; align-items: center; gap: 10px; font-size: 12px; }
  .cat__sort select {
    appearance: none; background: transparent; color: var(--text); border: 0; font: inherit; font-size: 13px; cursor: pointer;
    padding-right: 18px; background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 6px top 55%, right 2px top 55%; background-size: 4px 4px; background-repeat: no-repeat;
  }
  .cat__sort select option { background: var(--card); }
  .cat__empty { padding: 40px 0; }
  @media (max-width: 1023px) { .cat__group--all { display: none; } }
  @media (min-width: 1024px) { .cat__link--mobile { display: none !important; } }
  .card--cta__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.18; mix-blend-mode: luminosity; }
  .card--cta .card__media > div, .card--cta .card__media > span { position: relative; }

  @media (min-width: 1024px) {
    .cat { grid-template-columns: 220px 1fr; gap: 56px; }
    .cat__side { position: sticky; top: 130px; align-self: start; max-height: calc(100vh - 150px); overflow: auto; scrollbar-width: none; }
    .cat__group { border-bottom: 1px solid var(--line); padding: 18px 0 20px; }
    .cat__group:first-child { padding-top: 0; }
    .cat__group-title { font-size: 13px; color: var(--text); margin-bottom: 12px; }
    .cat__links { flex-direction: column; align-items: stretch; gap: 0; margin: 0; padding: 0; overflow: visible; }
    .cat__link { justify-content: space-between; height: auto; padding: 6px 0; border: 0; border-radius: 0; color: var(--muted); }
    .cat__link:hover { color: var(--text); }
    .cat__link.is-on { background: none; color: var(--accent); }
    .cat__link.is-on i { color: var(--accent); }
    .cat__filter { flex-wrap: wrap; margin: 0; padding: 0; overflow: visible; }
  }
</style>
