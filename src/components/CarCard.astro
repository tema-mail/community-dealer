---
import { type Car, carName, carUrl, formatKm, formatPrice, isWeak, photo, views } from '../data/cars';

interface Props { car: Car; eager?: boolean; /** машина передом направо (чередование в сетке) */ flip?: boolean }
const { car, eager = false, flip = false } = Astro.props;
const [left, right] = views(car);
const twoSides = left !== right;
const badge = car.used ? 'С пробегом' : car.status;
---
<a
  class:list={['card', { 'is-flip': flip && twoSides }]}
  href={carUrl(car)}
  data-brand={car.brand}
  data-model={car.model}
  data-body={car.body}
  data-status={car.used ? 'С пробегом' : car.status}
  data-price={car.price}
  data-year={car.year}
  data-weak={isWeak(car) ? '1' : undefined}
  data-sides={twoSides ? '2' : '1'}
>
  <div class="card__media">
    {/* весь кадр 4:3 без обрезки: машина видна целиком, перед и зад */}
    <img
      class="card__view card__view--l"
      src={photo(car, left, 800)}
      srcset={`${photo(car, left, 800)} 800w, ${photo(car, left, 1200)} 1200w`}
      sizes="(min-width: 1024px) 30vw, 50vw"
      alt={`${carName(car)} ${car.trim}, ${car.year}`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {twoSides && (
      <img
        class="card__view card__view--r"
        src={photo(car, right, 800)}
        srcset={`${photo(car, right, 800)} 800w, ${photo(car, right, 1200)} 1200w`}
        sizes="(min-width: 1024px) 30vw, 50vw"
        alt=""
        aria-hidden="true"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
    <span class:list={['card__badge caps', { 'card__badge--muted': badge !== 'В наличии' }]}>{badge}</span>
    <span class="card__plus" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4v16M4 12h16" /></svg>
    </span>
    <span class="card__dots" aria-hidden="true">{Array.from({ length: Math.min(car.photos.length, 4) }, () => <i />)}</span>
  </div>
  <div>
    <div class="card__name">{carName(car)}</div>
    {car.trim && <div class="card__trim">{car.trim}</div>}
    <div class="card__meta">
      {car.year} · {car.power} л.с. · {car.used && car.mileage ? formatKm(car.mileage) : car.body.toLowerCase()}
    </div>
    <div class="card__price">{formatPrice(car.price)}</div>
  </div>
</a>
