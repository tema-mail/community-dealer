---
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';
import Modals from '../components/Modals.astro';
import { bodyCatalogs, brandCatalogs, cars } from '../data/cars';
import { site, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** шапка сразу с фоном (на страницах без тёмного первого экрана) */
  solidHeader?: boolean;
  page?: 'home' | 'catalog' | 'car';
}
const { title, description, solidHeader = false, page } = Astro.props;
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: url('#order'), label: 'Под заказ' },
  { href: url('#order'), label: 'Трейд-ин' },
  { href: '#contacts', label: 'Контакты' },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0c0c" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Unbounded:wght@300;400&display=swap"
    />
  </head>
  <body>
    <header class:list={['header', { 'header--solid': solidHeader }]} data-header>
      <div class="wrap">
        <div class="header__top">
          <a class="header__place" href={site.map} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            {site.place}
          </a>
          <a class="header__logo" href={url()} aria-label="Community – на главную">
            <LogoMark id="hdr" />
            <span class="header__word chrome">COMMUNITY</span>
          </a>
          <div class="header__right">
            <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
            <a class="icon-btn" href={site.telegram} target="_blank" rel="noopener" aria-label="Telegram-канал Community">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.4 4.3 2.9 11.4c-1 .4-1 1.6 0 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.6 3.4c.6.4 1.4.1 1.6-.6l3-15.4c.2-1-.7-1.8-1.7-1.5ZM9.6 14.4l-.4 3.6-1.3-4 8.9-6.3-7.2 6.7Z" /></svg>
            </a>
            <a class="icon-btn" href={site.phoneHref} aria-label="Позвонить" style="display:none" data-mobile-call>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
            </a>
            <button class="icon-btn header__burger" type="button" aria-label="Меню" aria-expanded="false" data-burger aria-controls="site-nav">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8h16M4 16h16" /></svg>
            </button>
          </div>
        </div>
        <nav class="header__nav" id="site-nav" aria-label="Основное меню">
          <div class="drop">
            <a href={url('catalog/')} aria-current={page === 'catalog' || page === 'car' ? 'page' : undefined}>Каталог</a>
            <div class="drop__panel">
              <div class="drop__col">
                <p class="drop__title">Кузов</p>
                {bodyCatalogs.map((c) => <a href={url(`catalog/${c.slug}/`)}>{c.title} <i>{c.cars.length}</i></a>)}
              </div>
              <div class="drop__col">
                <p class="drop__title">Марка</p>
                {brandCatalogs.map((c) => <a href={url(`catalog/${c.slug}/`)}>{c.title} <i>{c.cars.length}</i></a>)}
              </div>
              <a class="drop__all" href={url('catalog/')}>Все автомобили <i>{cars.length}</i></a>
            </div>
          </div>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <button type="button" class="header__lead" data-lead="">Записаться на просмотр</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer" id="contacts">
      <div class="wrap">
        <a class="footer__phone" href={site.phoneHref}>{site.phone}</a>
        <p class="footer__hours">{site.hours} · {site.address}</p>
        <div class="footer__chips">
          <a class="btn" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
          <a class="btn" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn" href={site.map} target="_blank" rel="noopener">Как добраться</a>
        </div>
        <div class="footer__grid">
          <div>
            <p class="footer__h">Каталог</p>
            <a href={url('catalog/')}>Все автомобили</a>
            {bodyCatalogs.map((c) => <a href={url(`catalog/${c.slug}/`)}>{c.title}</a>)}
          </div>
          <div>
            <p class="footer__h">Марки</p>
            {brandCatalogs.map((c) => <a href={url(`catalog/${c.slug}/`)}>{c.title}</a>)}
          </div>
          <div>
            <p class="footer__h">Услуги</p>
            <a href={url('#order')}>Сделки с НДС и лизинг</a>
            <a href={url('#order')}>Трейд-ин и выкуп</a>
            <a href={url('#order')}>Страхование и оформление</a>
          </div>
          <div>
            <p class="footer__h">Шоурум</p>
            <a href={site.autoru} target="_blank" rel="noopener">Мы на auto.ru</a>
            <p>{site.address}</p>
            <p>{site.place}</p>
            <p>{site.hours}</p>
          </div>
        </div>
        <div class="footer__bottom">
          <span class="footer__brand"><LogoMark id="ftr" /> © 2026 Community Dealer</span>
          <span><a href={url('politika/')}>Политика обработки персональных данных</a> · Цены за наличный расчёт, не оферта</span>
        </div>
      </div>
    </footer>

    <Modals />

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
      const call = document.querySelector<HTMLElement>('[data-mobile-call]');
      const onScroll = () => header?.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      burger?.addEventListener('click', () => {
        const open = header?.classList.toggle('is-open') ?? false;
        burger.setAttribute('aria-expanded', String(open));
      });
      header?.querySelectorAll('.header__nav a, .header__lead').forEach((a) =>
        a.addEventListener('click', () => header.classList.remove('is-open')),
      );
      const mq = window.matchMedia('(max-width: 860px)');
      const syncCall = () => call && (call.style.display = mq.matches ? '' : 'none');
      syncCall();
      mq.addEventListener('change', syncCall);

      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
